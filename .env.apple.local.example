# Local Apple publishing configuration for this machine.
#
# Copy to .env.apple.local (which is git-ignored) and fill in your values:
#
#   cp .env.apple.local.example .env.apple.local
#
# scripts/release-apple.sh sources it automatically, so after this you can simply
# run:
#
#   ./scripts/release-apple.sh testflight
#
# Variables already exported in your shell take precedence over this file, so a
# one-off run can override any value without editing it.
#
# What belongs here: the identifiers that make up YOUR App Store Connect setup.
# What does NOT belong here: certificates, private keys, passwords, API keys or
# provisioning profile files. None of those are read from this file, and none of
# them should ever be written to the repository. See
# docs/APPLE-DEVELOPMENT-SIGNING.md.

# The base every bundle identifier is derived from (the main app id itself).
# The iOS and macOS apps share it, which is what makes them one App Store record.
export APPLE_BASE_BUNDLE_ID=top.jiejie12131.jiejiebox

# One App Group shared by the app and its extensions. Must start with "group.".
export APPLE_APP_GROUP_ID=group.top.jiejie12131.jiejiebox

# Optional. The team is auto-detected from the signing certificate's OU field, so
# this is normally unnecessary. Set it only to pin a specific team.
#export APPLE_TEAM_ID=

# Optional. Both default to false; enable only what your account has been granted.
#export APPLE_ENABLE_MULTICAST=false
#export APPLE_ENABLE_ICLOUD=false

# Optional. Manual signing needs explicit profile names; automatic does not.
#export APPLE_SIGNING_STYLE=automatic
