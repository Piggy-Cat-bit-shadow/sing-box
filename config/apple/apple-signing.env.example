# Example Apple signing configuration for the Jiejie fork.
#
# Copy this somewhere outside the repository (or into a file you have added to
# .gitignore), fill in your own values, and source it before building:
#
#   source /path/to/my-apple-signing.env
#   ./scripts/ci/check-apple-signing-environment.sh
#
# EVERY value here is personal to your Apple Developer account. None of it belongs
# in git: a Team ID is not secret, but the file is where a password or a profile
# name would end up, so the whole file stays out of the repository.
#
# See docs/APPLE-DEVELOPMENT-SIGNING.md for how to obtain each value.

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# unsigned     no Apple account; for CI and packaging checks only.
# development  signs with your team; produces something that actually runs.
APPLE_SIGNING_MODE=development

# automatic  Xcode creates and manages the profiles (best for one developer).
# manual     you name the profiles explicitly (needed for CI).
APPLE_SIGNING_STYLE=automatic

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
# Your 10-character Team ID, from the top right of the developer account page.
APPLE_TEAM_ID=

# The base every bundle identifier is derived from. Set it to a prefix your team
# owns; the build appends .extension, .standalone, .system, .share and .helper.
APPLE_BASE_BUNDLE_ID=

# One App Group shared by the app and all of its extensions. It must start with
# "group." and must be assigned to every App ID listed in the documentation.
APPLE_APP_GROUP_ID=

# ---------------------------------------------------------------------------
# Multicast
# ---------------------------------------------------------------------------
# Leave false unless Apple has granted you the Multicast Networking entitlement.
# Setting it true without that approval will fail signing.
APPLE_ENABLE_MULTICAST=false

# ---------------------------------------------------------------------------
# Profiles (required only when APPLE_SIGNING_STYLE=manual)
# ---------------------------------------------------------------------------
#IOS_APP_PROFILE=
#IOS_EXTENSION_PROFILE=
#IOS_UI_EXTENSION_PROFILE=
#MACOS_APP_PROFILE=
#MACOS_SYSTEM_EXTENSION_PROFILE=
#MACOS_HELPER_PROFILE=
