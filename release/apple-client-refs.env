# Apple client source selection - ONE repository, TWO UI branches.
#
# The two Apple products this fork ships take their Swift source from two different
# branches of the SAME Apple client repository:
#
#   iOS / SFI     custom Hako UI          branch hako-ui
#   macOS / SFM   original sing-box UI    branch dev
#
# They are not merged and must never be merged: each branch is a platform's UI
# source. The build checks both out separately and installs the SAME Libbox
# framework - built once from this repository at the parent commit - into each.
#
# # Why the iOS SHA is not written here
#
# The iOS source is this repository's `clients/apple` submodule. Its commit is
# already recorded authoritatively by the parent's gitlink, and a second copy of the
# same value here could disagree with it. Read it with:
#
#     git ls-tree HEAD clients/apple
#
# so there is exactly one place that says which iOS commit is being built.
#
# # Why the macOS SHA is pinned to a full commit
#
# The macOS source comes from a branch, but a release must not follow a branch tip:
# `dev` moves, and a build that resolves it at build time is not reproducible. The
# exact commit is recorded below and every build checks out that commit and verifies
# it is an ancestor of the declared branch, so a pin cannot silently drift off-branch.
#
# scripts/ci/apple-client-source.sh is the only reader of this file.

# The single Apple client repository. Both branches live here.
APPLE_CLIENT_REPOSITORY=https://github.com/Piggy-Cat-bit-shadow/sing-box-for-apple

# iOS / SFI: the branch the parent gitlink is expected to track. Informational - the
# gitlink, not this value, decides which iOS commit is built.
IOS_APPLE_BRANCH=hako-ui

# macOS / SFM: original sing-box UI, from this fork's mirror of upstream dev.
MACOS_APPLE_BRANCH=dev
MACOS_APPLE_SHA=d1224bb5081b3df5d0ecc55b1bd3d72ea6c60628
