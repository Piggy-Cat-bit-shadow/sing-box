        "server_port": 53
      }
    ],
    "final": "local-agh",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "http",
      "tag": "masque-h2",
      "listen": "127.0.0.1",
      "listen_port": 28440,
      "version": 2,
      "users": [
        {
          "username": "example",
          "password": "example"
        }
      ],
      "tls": {
