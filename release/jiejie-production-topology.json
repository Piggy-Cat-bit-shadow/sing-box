        "certificate_path": "/tmp/jiejie-fixture/cert.pem",
        "key_path": "/tmp/jiejie-fixture/key.pem"
      },
      "fallback": {
        "server": "127.0.0.1",
        "server_port": 28437
      }
    },
    {
      "type": "shadowtls",
      "tag": "shadowtls-in",
      "listen": "127.0.0.1",
      "listen_port": 28450,
      "version": 3,
      "users": [
        {
          "name": "example",
          "password": "example"
        }
      ],
      "password": "example",
