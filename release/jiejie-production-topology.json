      "users": [
        {
          "username": "example",
          "password": "example"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "riri.zhuzhu.jiejie12131.top",
        "certificate_path": "/tmp/jiejie-fixture/cert.pem",
        "key_path": "/tmp/jiejie-fixture/key.pem"
      },
      "masquerade": {
        "type": "proxy",
        "url": "http://127.0.0.1:28437",
        "rewrite_host": true
      },
      "unauthenticated_limits": {
        "enabled": true,
        "max_concurrent_per_ip": 8,
        "requests_per_second": 10,
        "burst": 20,
        "idle_timeout": "10s",
        "max_tracked_ips": 4096
      }
    },
    {
      "type": "anytls",
      "tag": "anytls-in",
      "listen": "127.0.0.1",
      "listen_port": 28436,
      "users": [
        {
          "name": "example",
          "password": "example"
