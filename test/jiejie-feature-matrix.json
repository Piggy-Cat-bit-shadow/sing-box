{
  "_note": "Feature matrix for the FORK's client-side capabilities. This is NOT the production topology and must never drive the minimal registry. It is used by client-feature tests that run against the upstream/default tag set, where HTTP outbounds and the extra protocol families exist. The production fixture is release/jiejie-production-topology.json.",

  "log": {"level": "info"},

  "inbounds": [
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "listen_port": 28470
    }
  ],

  "outbounds": [
    {"type": "direct", "tag": "direct"},

    {
      "type": "http",
      "tag": "masque-out-h3",
      "server": "127.0.0.1",
      "server_port": 28443,
      "version": 3,
      "username": "example",
      "password": "example",
      "http3_connection_pool": {"size": 2, "strategy": "round_robin"},
      "http3_fallback": {
        "initial_backoff": "5s",
        "max_backoff": "5m",
        "multiplier": 2,
        "reset_on_success": true
      },
      "tls": {"enabled": true, "server_name": "example.test"}
    },

    {
      "type": "http",
      "tag": "masque-out-h2",
      "server": "127.0.0.1",
      "server_port": 28440,
      "version": 2,
      "username": "example",
      "password": "example",
      "tls": {"enabled": true, "server_name": "example.test"}
    },

    {
      "type": "anytls",
      "tag": "anytls-out",
      "server": "127.0.0.1",
      "server_port": 28436,
      "password": "example",
      "idle_session_check_interval": "30s",
      "idle_session_timeout": "30s",
      "tls": {"enabled": true, "server_name": "example.test"}
    },

    {
      "type": "shadowtls",
      "tag": "shadowtls-out",
      "server": "127.0.0.1",
      "server_port": 28450,
      "version": 3,
      "password": "example",
      "tls": {"enabled": true, "server_name": "www.example.test"}
    },

    {
      "type": "shadowsocks",
      "tag": "ss2022-out",
      "server": "127.0.0.1",
      "server_port": 28460,
      "method": "2022-blake3-aes-128-gcm",
      "password": "AAAAAAAAAAAAAAAAAAAAAA=="
    },

    {"type": "selector", "tag": "select", "outbounds": ["direct"], "default": "direct"},
    {
      "type": "urltest",
      "tag": "auto",
      "outbounds": ["direct"],
      "url": "http://cp.cloudflare.com/",
      "interval": "3m",
      "tolerance": 50
    },
    {"type": "block", "tag": "block"}
  ],

  "route": {
    "rules": [
      {"action": "sniff"},
      {"ip_is_private": true, "outbound": "direct"},
      {"action": "reject", "domain_suffix": [".ads.test"]}
    ],
    "final": "direct"
  }
}
